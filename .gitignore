# Python
__pycache__/
*.py[cod]

# Env & secrets — intentionally tracked for this hackathon demo (backend/.env
# is committed with live keys so judges/teammates can run it as-is). Revert
# this after the event.

# Generated state — db/sqlite/data/app.db and db/vectordb/data/chroma are
# tracked on purpose (pushed with the repo). WAL/SHM are pure churn on every
# request and never worth tracking; one-off debugging backup folders
# (chroma_*_backup_*, chroma_pre_*) are local scratch, not the real DB.
db/sqlite/data/*.db-wal
db/sqlite/data/*.db-shm
db/vectordb/data/chroma_broken_backup_*/
db/vectordb/data/chroma_corrupt_backup_*/
db/vectordb/data/chroma_pre_*/

# Node
node_modules/
dist/
.vite/
*.tsbuildinfo

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db
