# Copy to .env and edit. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# "local"  -> Ollama at OPENAI_BASE_URL (default, always works offline)
# "hosted" -> GenAI Lab gateway; falls back to local if the startup probe fails.
LLM_PROVIDER=hosted

OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://genailab.tcs.in/v1

LLM_MODEL=azure/genailab-maas-gpt-4.1
FAST_LLM_MODEL=azure/genailab-maas-gpt-4.1-mini
REASONING_MODEL=genailab-maas-gpt-5.1
EMBEDDING_MODEL=azure/genailab-maas-text-embedding-3-large

# Vision model for images and scanned PDF pages. Empty disables the vision path.
VISION_MODEL=azure_ai/genailab-maas-Llama-3.2-90B-Vision-Instruct
WHISPER_MODEL=azure/genailab-maas-whisper

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Local Ollama is plain http and corporate proxies break cert validation.
DISABLE_SSL_VERIFY=true

# --- retrieval --------------------------------------------------------------
# TicketSphere ships hybrid (BM25 + dense) — exact INC/error codes need lexical hit.
# Re-run retrieval A/B before flipping back to vector.
RETRIEVAL_MODE=hybrid
TICKET_SOURCE=synthetic

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=20
FINAL_TOP_K=6
RRF_K=60

RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- storage ----------------------------------------------------------------
CHROMA_PERSIST_DIR=chroma
CHROMA_COLLECTION=knowledge_base
UPLOAD_DIR=uploads
SEED_DIR=seed

# --- auth -------------------------------------------------------------------
JWT_SECRET=change-me-before-demo
JWT_EXPIRY_HOURS=12

# --- limits -----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
MAX_PARALLEL_WORKERS=4
MAX_UPLOAD_MB=25

# --- app --------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true

DOMAIN=TicketSphere
