# Copy to .env and edit. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# "local"  -> Ollama at OPENAI_BASE_URL (default, always works offline)
# "hosted" -> GenAI Lab gateway; falls back to local if the startup probe fails.
LLM_PROVIDER=hosted

OPENAI_API_KEY=replace-me
OPENAI_BASE_URL=https://genailab.tcs.in/v1

# Optional — chat's own provider, independent of OPENAI_BASE_URL/OPENAI_API_KEY
# above (those two are also what embeddings uses; see config.py::LLM_BASE_URL
# for why chat can't just repoint them). Leave both blank to fall back to
# OPENAI_BASE_URL/OPENAI_API_KEY, unchanged from before this existed. Example
# for DeepSeek (no embeddings endpoint, chat only):
# LLM_BASE_URL=https://api.deepseek.com
# LLM_API_KEY=replace-me
LLM_BASE_URL=
LLM_API_KEY=

LLM_MODEL=azure/genailab-maas-gpt-4.1
FAST_LLM_MODEL=azure/genailab-maas-gpt-4.1-mini
REASONING_MODEL=genailab-maas-gpt-5.1
EMBEDDING_MODEL=azure/genailab-maas-text-embedding-3-large

# Vision model for images and scanned PDF pages. Empty disables the vision path.
VISION_MODEL=azure_ai/genailab-maas-Llama-3.2-90B-Vision-Instruct
WHISPER_MODEL=azure/genailab-maas-whisper

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Local Ollama is plain http and corporate proxies break cert validation.
DISABLE_SSL_VERIFY=true

# --- retrieval --------------------------------------------------------------
# TicketSphere ships hybrid (BM25 + dense) — exact INC/error codes need lexical hit.
# Re-run retrieval A/B before flipping back to vector.
RETRIEVAL_MODE=hybrid
# "synthetic" (default demo) or "jira" (live Atlassian board).
TICKET_SOURCE=synthetic

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=20
FINAL_TOP_K=6
RRF_K=60

RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- jira (only when TICKET_SOURCE=jira) ------------------------------------
# Leave empty for synthetic demo. Never put real tokens in committed files.
# JIRA_BASE_URL e.g. https://brainbytes.atlassian.net
JIRA_BASE_URL=
JIRA_EMAIL=
JIRA_API_TOKEN=
JIRA_PROJECT_KEY=SCRUM
JIRA_POLL_SECONDS=30
# Live board has no custom triage fields yet; adapter uses Priority+labels+comment.
JIRA_FIELD_SEVERITY=
JIRA_FIELD_PRIORITY_SCORE=
JIRA_FIELD_ROUTED_TEAM=
JIRA_FIELD_AI_CONFIDENCE=

# --- SLA breach notification -------------------------------------------------
# Emails admin/manager users (looked up by User.email, see db/sqlite/models.py)
# once a ticket crosses this fraction of its Priority's SLA resolve target.
# Sent via Resend's HTTPS API (works even where SMTP ports are firewalled —
# see integrations/notifications.py). Sign up free at resend.com, generate an
# API key, paste it here.
SLA_WARNING_THRESHOLD=0.70
SLA_CHECK_SECONDS=900
RESEND_API_KEY=
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# --- storage ----------------------------------------------------------------
CHROMA_PERSIST_DIR=chroma
CHROMA_COLLECTION=knowledge_base
UPLOAD_DIR=uploads
SEED_DIR=seed

# --- auth -------------------------------------------------------------------
JWT_SECRET=change-me-before-demo
JWT_EXPIRY_HOURS=12

# --- limits -----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
MAX_PARALLEL_WORKERS=4
MAX_UPLOAD_MB=25

# --- app --------------------------------------------------------------------
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true

DOMAIN=TicketSphere
