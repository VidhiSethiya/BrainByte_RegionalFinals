# Copy to .env and edit. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# "local"  -> Ollama at OPENAI_BASE_URL (default, always works offline)
# "hosted" -> real OpenAI-compatible endpoint; falls back to local if the startup
#             probe fails, so a bad key on build day is not fatal.
LLM_PROVIDER=local

# Local: dummy value, the client only requires it to be non-empty.
# Hosted: paste the real key here on build day.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

LLM_MODEL=llama-3.2-3b-it:latest
EMBEDDING_MODEL=gte-large:latest

# Faster model for guardrails, rewriting and scoring. Same as LLM_MODEL locally.
FAST_LLM_MODEL=llama-3.2-3b-it:latest

# Vision model for images and scanned PDF pages. Empty disables the vision path.
# Local option: ollama pull llama3.2-vision:11b  ->  VISION_MODEL=llama3.2-vision:11b
VISION_MODEL=

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Local Ollama is plain http and corporate proxies break cert validation.
# Leave true unless you have a reason not to.
DISABLE_SSL_VERIFY=true

# --- retrieval --------------------------------------------------------------
# vector = embedding similarity only (default)
# hybrid = vector + BM25 keyword search fused with RRF
# Switch to hybrid only if the corpus has exact identifiers embeddings blur.
RETRIEVAL_MODE=vector

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=20          # candidates per index before fusion
FINAL_TOP_K=6              # chunks actually sent to the LLM
RRF_K=60

# Cross-encoder reranking. Needs sentence-transformers (pulls torch) — off by default.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- storage ----------------------------------------------------------------
# Relative paths resolve under vectordb/data/
CHROMA_PERSIST_DIR=chroma
CHROMA_COLLECTION=knowledge_base
UPLOAD_DIR=uploads
SEED_DIR=seed

# --- auth -------------------------------------------------------------------
JWT_SECRET=change-me-before-demo
JWT_EXPIRY_HOURS=12

# --- limits -----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
MAX_PARALLEL_WORKERS=4
MAX_UPLOAD_MB=25

# --- app --------------------------------------------------------------------
# Frontend and backend share this origin, so there is no CORS configuration.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true
