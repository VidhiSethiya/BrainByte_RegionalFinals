# Copy to .env and edit. Never commit .env.

# --- LLM provider -----------------------------------------------------------
# "local"  -> Ollama at OPENAI_BASE_URL (default, always works offline)
# "hosted" -> TCS AI Fridays LiteLLM gateway; falls back to local automatically if
#             the startup probe fails, so a missing/bad key on build day is not
#             fatal — ai/llm.py::resolve_provider() does this once at boot.
LLM_PROVIDER=local

# Local: dummy value, the client only requires it to be non-empty.
# Hosted: paste the team key issued at the event.
OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1
#   OPENAI_BASE_URL=https://genailab.tcs.in
#   OPENAI_API_KEY=<team key>

LLM_MODEL=llama-3.2-3b-it:latest
# Hosted: LLM_MODEL=azure/genailab-maas-gpt-4.1


FAST_LLM_MODEL=llama-3.2-3b-it:latest
# Hosted: FAST_LLM_MODEL=azure/genailab-maas-gpt-4.1-mini

# DEEP — the highest-blast-radius decisions: ticket severity/priority, agent
# self-reflection, manager KB answers. ~15% of calls; this is where the token
# budget is deliberately spent, not the biggest model everywhere.
REASONING_MODEL=llama-3.2-3b-it:latest
# Hosted: REASONING_MODEL=genailab-maas-gpt-5.1

# Embeddings. Owned by the RAG/DB workstream (rag.md) — do not flip this value
# without reseeding immediately after (python db/vectordb/seed_vector_db.py
# --reset). Changing it mid-build invalidates the index.
EMBEDDING_MODEL=gte-large:latest
# Hosted (recommended for this corpus — ticket text is short and identifier-dense,
# 3072-dim measurably improves symptom matching over the local 1024-dim encoder):
#   EMBEDDING_MODEL=azure/genailab-maas-text-embedding-3-large

# Vision model for images, screenshots and scanned PDF pages. Empty disables the
# vision path — attachments index as text-only chunks instead of erroring.
# Local option: ollama pull llama3.2-vision:11b  ->  VISION_MODEL=llama3.2-vision:11b
VISION_MODEL=
# Hosted: VISION_MODEL=azure_ai/genailab-maas-Llama-3.2-90B-Vision-Instruct

# Speech-to-text for POST /api/voice/transcribe. Empty disables the endpoint; the
# frontend's mic button hides itself rather than erroring.
WHISPER_MODEL=
# Hosted: WHISPER_MODEL=azure/genailab-maas-whisper

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Local Ollama is plain http and corporate proxies break cert validation.
# Leave true unless you have a reason not to.
DISABLE_SSL_VERIFY=true

# --- retrieval --------------------------------------------------------------
# vector = embedding similarity only (default)
# hybrid = vector + BM25 keyword search fused with RRF
# Switch to hybrid only if the corpus has exact identifiers embeddings blur.
RETRIEVAL_MODE=vector

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=20          # candidates per index before fusion
FINAL_TOP_K=6              # chunks actually sent to the LLM
RRF_K=60

# Cross-encoder reranking. Needs sentence-transformers (pulls torch) — off by default.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- storage ----------------------------------------------------------------
# Relative paths resolve under vectordb/data/
CHROMA_PERSIST_DIR=chroma
CHROMA_COLLECTION=knowledge_base
UPLOAD_DIR=uploads
SEED_DIR=seed

# --- auth -------------------------------------------------------------------
JWT_SECRET=change-me-before-demo
JWT_EXPIRY_HOURS=12

# --- limits -----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
MAX_PARALLEL_WORKERS=4
MAX_UPLOAD_MB=25

# --- app --------------------------------------------------------------------
# Frontend and backend share this origin, so there is no CORS configuration.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true
