# Local, gitignored. Copied from .env.example and switched to the hosted gateway.
# Never commit this file.

# --- LLM provider -----------------------------------------------------------
# Hosted TCS AI Fridays LiteLLM gateway hit its $50 budget cap (429
# budget_exceeded) mid-session — chat now runs on DeepSeek instead. Kept
# OPENAI_API_KEY/OPENAI_BASE_URL pointed at the TCS gateway below because
# get_embeddings() (ai/llm.py) still uses those two, unconditionally, for
# embeddings — DeepSeek has no embeddings endpoint at all, and swapping the
# vector space mid-corpus would silently corrupt retrieval. LLM_BASE_URL/
# LLM_API_KEY (config.py) is the new, independent knob chat actually reads via
# resolve_provider(); if the TCS budget resets, chat can move back by just
# clearing these two rather than touching OPENAI_BASE_URL/OPENAI_API_KEY.
LLM_PROVIDER=hosted

OPENAI_API_KEY=ollama
OPENAI_BASE_URL=http://localhost:11434/v1

LLM_BASE_URL=https://api.deepseek.com
LLM_API_KEY=sk-bd64d0230869452cb2f2ae7308963055

# --- model tiers --------------------------------------------------------
# Three tiers, not one model — see docs/JUDGES_QA.md "Which model are you using?"
# and ai/llm.py::get_llm(tier=...). DeepSeek has two chat models, not three
# tiers' worth — deepseek-chat (V3) covers standard+fast, deepseek-reasoner
# (R1) is the deep tier for the decisions worth the extra reasoning (severity,
# self-reflection, manager Q&A).

# STANDARD — generation, classification, routing.
LLM_MODEL=deepseek-chat

# FAST — ~70% of all calls: plan, query rewrite, CRAG grading, guardrail JSON,
# summaries.
FAST_LLM_MODEL=deepseek-chat

# DEEP — ticket severity/priority, agent self-reflection, manager KB answers.
# ~15% of calls; this is where the token budget is deliberately spent.
REASONING_MODEL=deepseek-reasoner

# Embeddings: pinned to local Ollama (gte-large) as of 2026-08-08. TCS gateway
# hit its $50 budget cap ($50.02/$50) and every hosted embedding call was
# 429'ing then silently falling back to local anyway, mixing two embedding
# spaces in the same Chroma collection and tanking retrieval quality (and with
# it, confidence — see ai/agents.py::_evidence_coverage). Reseeded with
# `--reset` immediately after this change so the whole corpus is one
# consistent local vector space. Revert to the hosted model + reseed again if
# the TCS budget resets.
EMBEDDING_MODEL=gte-large:latest

# Vision model for images, screenshots and scanned PDF pages.
VISION_MODEL=azure_ai/genailab-maas-Llama-3.2-90B-Vision-Instruct

# Speech-to-text for POST /api/voice/transcribe.
WHISPER_MODEL=azure/genailab-maas-whisper

LLM_TEMPERATURE=0.1
LLM_TIMEOUT_SECONDS=60
LLM_MAX_RETRIES=1

# Local Ollama is plain http and corporate proxies break cert validation.
# Leave true unless you have a reason not to.
DISABLE_SSL_VERIFY=true

# --- retrieval --------------------------------------------------------------
# vector = embedding similarity only (default)
# hybrid = vector + BM25 keyword search fused with RRF
# Switch to hybrid only if the corpus has exact identifiers embeddings blur.
RETRIEVAL_MODE=vector

CHUNK_SIZE=900
CHUNK_OVERLAP=150
RETRIEVE_TOP_K=20          # candidates per index before fusion
FINAL_TOP_K=6              # chunks actually sent to the LLM
RRF_K=60

# Cross-encoder reranking. Needs sentence-transformers (pulls torch) — off by default.
RERANK_ENABLED=false
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# --- ticket source: Jira integration -----------------------------------------
# Verified against the real board via the Atlassian connector on 2026-08-07:
# cloud id 3975e197-7e5f-47ad-9d2c-1046a1f39d6c, project "INC" ("TicketSphere"),
# 14 real tickets already on it. Flip TICKET_SOURCE to "jira" once JIRA_API_TOKEN
# below is filled in — everything else is ready. Until then the poller runs
# against TICKET_SOURCE=synthetic (reads db/vectordb/data/seed/tickets/, calls
# nothing external) and never touches the real board.
TICKET_SOURCE=jira

JIRA_BASE_URL=https://brainbytes.atlassian.net
JIRA_EMAIL=aifridayteam8@gmail.com
# Token name in Atlassian: "atlassian-login-ticketsphere". Generated 2026-08-07.
JIRA_API_TOKEN=ATATT3xFfGF0EWuyVy8Ejlx7CKjXkoi2ph03S7xqGdADO_VW5QvfToZnHV3LsSGNLhfCEgek2g99x2jQgIhAHiiJAQNNJPHuiUhhMWCgCUEW7z9hOw6twbIssQN9mO7m9RhcpkbV3kWdy_FVwpG9Di5FWisbXh0wQ_esGOjn0hQkLFisVqSx1PA=81211E3D
JIRA_PROJECT_KEY=INC
JIRA_POLL_SECONDS=30
# Custom field ids — confirmed against the real board: none of these exist as
# custom fields (only Jira's stock Priority/Labels/Team-picker/Sprint). Leave
# empty; integrations/jira.py::update() already writes severity onto the native
# Priority field and team/severity as labels instead, with zero admin setup.
# Fill these in only if someone later creates dedicated custom fields in Jira.
JIRA_FIELD_SEVERITY=
JIRA_FIELD_PRIORITY_SCORE=
JIRA_FIELD_ROUTED_TEAM=
JIRA_FIELD_AI_CONFIDENCE=

# --- SLA breach notification -------------------------------------------------
# Emails admin/manager users (User.email — see db/sqlite/models.py) once a
# ticket crosses this fraction of its Priority's SLA resolve target.
# Sign up free at resend.com, generate an API key, paste it below. Sends are
# skipped (logged, non-fatal) until this is set.
SLA_WARNING_THRESHOLD=0.70
SLA_CHECK_SECONDS=900
RESEND_API_KEY=re_xAC7LgXT_JezmG7aAyEPxv7Aeh6oAMMkM
NOTIFY_FROM_EMAIL=onboarding@resend.dev

# --- storage ----------------------------------------------------------------
# Relative paths resolve under vectordb/data/
CHROMA_PERSIST_DIR=chroma
CHROMA_COLLECTION=knowledge_base
UPLOAD_DIR=uploads
SEED_DIR=seed

# --- auth -------------------------------------------------------------------
JWT_SECRET=change-me-before-demo
JWT_EXPIRY_HOURS=12

# --- limits -----------------------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
MAX_PARALLEL_WORKERS=4
MAX_UPLOAD_MB=25

# --- app --------------------------------------------------------------------
# Frontend and backend share this origin, so there is no CORS configuration.
HOST=127.0.0.1
PORT=5000
FLASK_DEBUG=true
